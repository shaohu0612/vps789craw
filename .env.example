# GitHub Personal Access Token (可选，用于本地或外部触发推送到仓库 shaohu0612/vps789craw)
# 若在 GitHub Actions 内部运行，系统会自动提供 GITHUB_TOKEN，或可在仓库 Settings -> Secrets 中配置 GH_PAT
GH_PAT=ghp_your_github_personal_access_token_here

# 自定义抓取参数（可选）
CRAWL_TYPE=all
DOMAINS_FILE=vps789-domains
BESTIP_FILE=vps789-bestip
PREFIX=vps789-
